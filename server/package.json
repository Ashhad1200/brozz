{
  "name": "brozz-server",
  "version": "1.0.0",
  "description": "Express + Prisma + PostgreSQL API for the Brozz shop",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && node src/index.js",
    "dev": "prisma migrate deploy && node --watch src/index.js",
    "seed": "prisma migrate deploy && node src/db/seed.js",
    "create-admin": "prisma migrate deploy && node src/db/create-admin.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
