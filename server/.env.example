PORT=8000
DATABASE_URL=postgres://brozz:brozz@localhost:5432/brozz
# Only used by `npm test`; the test suite wipes this database.
TEST_DATABASE_URL=postgres://brozz:brozz@localhost:5432/brozz_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
